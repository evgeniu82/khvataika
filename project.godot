; CLAW MACHINE — REALISTIC WOOD / METAL / GLASS EDITION
; Godot 4.7+
config_version=5

[application]
config/name="Хватайка"
config/version="1.13.3"
config/icon="res://store/icon_512.png"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.09, 0.06, 0.04, 1)
boot_splash/image="res://assets/loading_miniature.png"

[editor_plugins]
enabled=PackedStringArray("res://addons/khvataika_background_notifications/plugin.cfg")

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.driver="opengl3"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[environment]
defaults/default_clear_color=Color(0.05, 0.035, 0.025, 1)

[input]
move_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]}
move_forward={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
drop_claw={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}

[physics]
3d/default_gravity=9.8
common/physics_ticks_per_second=60

[rendering/occlusion_culling]
use_occlusion_culling=true
